{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@vglafirov/opencode-gitlab-plugin",
    "@vglafirov/opencode-gitlab-auth",
    "opencode-skills",
  ],
  "lsp": {
    "terraform": {
      "command": [
        "terraform-ls",
        "serve"
      ],
      "extensions": [
        ".tf",
        ".tfvars"
      ],
      "env": {},
      "initialization": {}
    }
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "mcp/grafana",
        "-t",
        "stdio"
      ],
      "environment": {
        "GRAFANA_URL": "https://dashboards.gitlab.net"
      }
    },
    "gcloud": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@google-cloud/gcloud-mcp"
      ]
    },
    "knowledge-graph": {
      "type": "remote",
      "url": "http://localhost:27495/mcp/sse",
      "enabled": true
    },
    "terraform": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:0.3.3"
      ]
    }
  }
}
